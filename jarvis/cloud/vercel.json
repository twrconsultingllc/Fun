{
  "ignoreCommand": "p=\"$VERCEL_GIT_PREVIOUS_SHA\"; git cat-file -e \"$p^{commit}\" 2>/dev/null || p=HEAD^; git diff --quiet \"$p\" HEAD -- . || exit 1",
  "functions": {
    "api/voice.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; frame-ancestors 'none'"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), usb=(), payment=()"
        }
      ]
    }
  ]
}
